{
  "name": "ClientSOP",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Reference to Client entity \u2014 one SOP per client"
    },
    "call_script": {
      "type": "string",
      "description": "Main call script setters read during live calls. Supports markdown."
    },
    "faqs": {
      "type": "string",
      "description": "Frequently asked questions and answers. Supports markdown."
    },
    "talking_points": {
      "type": "string",
      "description": "Industry-specific talking points, objection handling. Supports markdown."
    },
    "general_notes": {
      "type": "string",
      "description": "Any other reference info setters need. Supports markdown."
    },
    "last_updated": {
      "type": "string",
      "description": "ISO date string, auto-set on save"
    }
  },
  "required": [
    "client_id"
  ]
}